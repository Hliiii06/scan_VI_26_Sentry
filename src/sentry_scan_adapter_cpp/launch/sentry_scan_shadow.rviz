  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: Goal
    Namespaces:
      ? ''
      : true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sentry_scan/goal_point
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
      FL_calf:
        Value: true
      FL_calf_rotor:
        Value: true
      FL_foot:
        Value: true
      FL_hip:
        Value: true
      FL_hip_rotor:
        Value: true
      FL_thigh:
        Value: true
      FL_thigh_rotor:
        Value: true
      FR_calf:
        Value: true
      FR_calf_rotor:
        Value: true
      FR_foot:
        Value: true
      FR_hip:
        Value: true
      FR_hip_rotor:
        Value: true
      FR_thigh:
        Value: true
      FR_thigh_rotor:
        Value: true
      RL_calf:
        Value: true
      RL_calf_rotor:
        Value: true
      RL_foot:
        Value: true
      RL_hip:
        Value: true
      RL_hip_rotor:
        Value: true
      RL_thigh:
        Value: true
      RL_thigh_rotor:
        Value: true
      RR_calf:
        Value: true
      RR_calf_rotor:
        Value: true
      RR_foot:
        Value: true
      RR_hip:
        Value: true
      RR_hip_rotor:
        Value: true
      RR_thigh:
        Value: true
      RR_thigh_rotor:
        Value: true
      base:
        Value: true
      front_camera:
        Value: true
      imu_link:
        Value: true
      sensor:
        Value: true
      sliding_map:
        Value: true
      trunk:
        Value: true
      world:
        Value: true
    Marker Scale: 1
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree:
      world:
        base:
          trunk:
            FL_hip:
              FL_thigh:
                FL_calf:
                  FL_foot: {}
                FL_calf_rotor: {}
              FL_thigh_rotor: {}
            FL_hip_rotor: {}
            FR_hip:
              FR_thigh:
                FR_calf:
                  FR_foot: {}
                FR_calf_rotor: {}
              FR_thigh_rotor: {}
            FR_hip_rotor: {}
            RL_hip:
              RL_thigh:
                RL_calf:
                  RL_foot: {}
                RL_calf_rotor: {}
              RL_thigh_rotor: {}
            RL_hip_rotor: {}
            RR_hip:
              RR_thigh:
