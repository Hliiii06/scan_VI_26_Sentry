      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /sentry_scan/grid_map/occupancy_inflate
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 2.1538519859313965
      Min Value: -0.15081557631492615
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 199
    Min Color: 0; 0; 0
    Min Intensity: 199
    Name: Sensor Cloud
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /sentry_scan/cloud
