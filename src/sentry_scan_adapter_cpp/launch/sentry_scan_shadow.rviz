Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 1206
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded: null
  Name: Tool Properties
  Splitter Ratio: 0.5
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/PointCloud2
    Enabled: true
    Name: Terrain surface (colour = height)
    Position Transformer: XYZ
    Queue Size: 10
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.02
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /sentry_scan/ground_surface
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Enabled: false
    Name: Original map (unfiltered, for comparison)
    Position Transformer: XYZ
    Queue Size: 10
    Selectable: true
    Size (Pixels): 1
    Size (m): 0.01
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /sentry_scan/global_cloud_raw
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/Marker
    Enabled: false
    Name: Terrain surface (solid mesh, off by default)
    Namespaces:
      terrain_surface: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sentry_scan/terrain_surface_mesh
    Value: true
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: Robot body (solid)
