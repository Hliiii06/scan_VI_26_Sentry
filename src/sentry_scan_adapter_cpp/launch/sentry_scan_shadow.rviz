    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Ground Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 60
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 20.178617477416992
      Min Value: -20.31769561767578
      Value: true
    Axis: X
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 192; 191; 188
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: SCAN map (global_cloud)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 1
    Size (m): 0.012000000104308128
    Style: Flat Squares
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /sentry_scan/global_cloud
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 0.65
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 0.574999988079071
      Min Value: -0.125
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 0; 200; 255
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
