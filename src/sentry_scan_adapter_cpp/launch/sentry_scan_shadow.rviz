                  RR_foot: {}
                RR_calf_rotor: {}
              RR_thigh_rotor: {}
            RR_hip_rotor: {}
            front_camera: {}
            imu_link: {}
        sensor: {}
        sliding_map: {}
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: SCAN path (optimal_list Marker)
    Namespaces:
      ? ''
      : true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sentry_scan/optimal_list
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 82; 255; 130
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: RM filtered cloud (/pointcloud)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.01
    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /pointcloud
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Axes Length: 0.6
    Axes Radius: 0.05
    Class: rviz_default_plugins/Odometry
    Covariance:
      Orientation:
        Alpha: 0.5
        Color: 255; 255; 127
        Color Style: Unique
        Frame: Local
        Offset: 1
        Scale: 1
        Value: false
      Position:
        Alpha: 0.3
        Color: 204; 51; 204
        Scale: 1
        Value: false
      Value: false
    Enabled: true
    Keep: 1
    Name: RM odom (/Odometry_transformed)
    Position Tolerance: 0.05
    Shape:
      Alpha: 1
      Axes Length: 0.6
      Axes Radius: 0.05
      Color: 255; 25; 0
      Head Length: 0.2
      Head Radius: 0.075
      Shaft Length: 0.4
      Shaft Radius: 0.05
      Value: Arrow
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /Odometry_transformed
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
