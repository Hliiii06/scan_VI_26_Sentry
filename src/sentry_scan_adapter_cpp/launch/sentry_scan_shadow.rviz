      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sentry_scan/body_marker
    Value: true
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: Sentry envelope + heading (debug)
    Namespaces:
      self_heading: true
      self_inflation: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sentry_scan/self_inflation
    Value: true
  - Alpha: 0.5
